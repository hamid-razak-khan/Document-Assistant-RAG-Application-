# ===========================================
# Django Configuration
# ===========================================
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION-use-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ===========================================
# Groq LLM API Configuration
# ===========================================
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Available models:
# - llama-3.3-70b-versatile (Recommended - Best quality)
# - mixtral-8x7b-32768 (Fast, good balance)
# - llama-3.1-8b-instant (Fastest, lower quality)
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# ===========================================
# ChromaDB Vector Store Configuration
# ===========================================
CHROMA_DB_DIR=chroma_store

# ===========================================
# Top-K LLM Analysis Optimization
# ===========================================
# Only analyze top K resumes with LLM (saves API costs)
# Remaining resumes get algorithmic score only
# Recommended: 3-5 for optimal balance
MAX_LLM_ANALYSIS=3
